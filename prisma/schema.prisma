generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANT ──────────────────────────────────────────
model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  plan         String   @default("free")
  shopeeShopId String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  products           Product[]
  categories         Category[]
  stockEntries       StockEntry[]
  stockExits         StockExit[]
  sales              Sale[]
  notifications      Notification[]
  integrationConfigs IntegrationConfig[]
  webhookEvents      WebhookEvent[]
  activityLogs       ActivityLog[]

  // NOVO: relações de monetização
  subscription       Subscription?
  billingEvents      BillingEvent[]

  @@index([slug])
}

// ─── USUÁRIOS ──────────────────────────────────────────────
enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  SUPERADMIN
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(MEMBER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── PRODUTOS ──────────────────────────────────────────────
enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id              String        @id @default(cuid())
  tenantId        String
  categoryId      String?
  name            String
  sku             String
  description     String?       @db.Text
  imageUrl        String?
  costPrice       Decimal       @default(0) @db.Decimal(10, 2)
  salePrice       Decimal       @default(0) @db.Decimal(10, 2)
  profitMargin    Decimal       @default(0) @db.Decimal(5, 2)
  stockQuantity   Int           @default(0)
  minStockLevel   Int           @default(5)
  unit            String        @default("un")
  shopeeProductId String?
  status          ProductStatus @default(ACTIVE)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  category     Category?   @relation(fields: [categoryId], references: [id])
  stockEntries StockEntry[]
  stockExits   StockExit[]
  saleItems    SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([status])
}

// ─── MOVIMENTAÇÕES DE ESTOQUE ──────────────────────────────
model StockEntry {
  id               String   @id @default(cuid())
  tenantId         String
  productId        String
  userId           String?
  quantity         Int
  unitCost         Decimal  @db.Decimal(10, 2)
  totalCost        Decimal  @db.Decimal(10, 2)
  averageCostAfter Decimal  @db.Decimal(10, 2)
  supplier         String?
  notes            String?  @db.Text
  entryDate        DateTime @default(now())
  createdAt        DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([entryDate])
}

model StockExit {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  saleItemId  String?
  quantity    Int
  costAtExit  Decimal  @db.Decimal(10, 2)
  reason      String   @default("SALE")
  referenceId String?
  notes       String?  @db.Text
  exitDate    DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([exitDate])
}

// ─── VENDAS ────────────────────────────────────────────────
enum SaleStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SaleChannel {
  MANUAL
  SHOPEE
  ELO7
  MAGALU
  MERCADO_LIVRE
  AMAZON
  OTHER
}

model Sale {
  id              String      @id @default(cuid())
  tenantId        String
  userId          String?
  channel         SaleChannel @default(MANUAL)
  externalOrderId String?
  customerName    String?
  customerEmail   String?
  subtotal        Decimal     @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  shippingCost    Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  totalCost       Decimal     @default(0) @db.Decimal(10, 2)
  profit          Decimal     @default(0) @db.Decimal(10, 2)
  status          SaleStatus  @default(PAID)
  notes           String?     @db.Text
  saleDate        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  items  SaleItem[]

  @@index([tenantId])
  @@index([channel])
  @@index([status])
  @@index([saleDate])
  @@index([externalOrderId])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  unitCost   Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  profit     Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// ─── NOTIFICAÇÕES ──────────────────────────────────────────
enum NotificationType {
  NEW_SALE
  LOW_STOCK
  OUT_OF_STOCK
  INTEGRATION_ERROR
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String?
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── INTEGRAÇÕES ───────────────────────────────────────────
model IntegrationConfig {
  id                  String    @id @default(cuid())
  tenantId            String
  type                String
  encryptedCredentials String   @db.Text
  isActive            Boolean   @default(false)
  isMockMode          Boolean   @default(true)
  lastSyncAt          DateTime?
  syncIntervalMinutes Int       @default(5)
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
  @@index([tenantId])
}

model WebhookEvent {
  id           String    @id @default(cuid())
  tenantId     String
  source       String
  eventType    String
  payload      Json
  status       String    @default("received")
  errorMessage String?   @db.Text
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([source])
  @@index([status])
  @@index([createdAt])
}

// ─── AUDITORIA ─────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity])
  @@index([createdAt])
}

// ─── NOVO MODELO: Assinatura ───────────────────────────────
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum PlanName {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  plan                 PlanName           @default(FREE)
  status               SubscriptionStatus @default(TRIALING)

  // IDs externos dos gateways (null enquanto não integrado)
  stripeSubscriptionId    String? @unique
  stripeCustomerId        String? @unique
  mercadoPagoSubId        String? @unique
  mercadoPagoCustomerId   String?

  // Período atual
  currentPeriodStart   DateTime @default(now())
  currentPeriodEnd     DateTime
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  cancelReason         String?

  // Billing
  priceMonthly         Decimal  @default(0) @db.Decimal(10,2)
  currency             String   @default("BRL")

  // Metadados
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([tenantId])
}

// ─── NOVO MODELO: Eventos de cobrança ──────────────────────
enum BillingEventType {
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELED
  TRIAL_ENDED
  INVOICE_CREATED
}

model BillingEvent {
  id          String           @id @default(cuid())
  tenantId    String
  type        BillingEventType
  gateway     String           // 'stripe' | 'mercadopago' | 'manual'
  externalId  String?          // ID do evento no gateway
  amount      Decimal?         @db.Decimal(10,2)
  currency    String           @default("BRL")
  status      String           @default("received")
  payload     Json?            // Payload raw do gateway
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([type])
  @@index([gateway, externalId])
  @@index([createdAt])
}

// ─── NOVO MODELO: Log de bloqueios por limite ──────────────
model PlanLimitHit {
  id           String   @id @default(cuid())
  tenantId     String
  limitType    String   // 'products' | 'users' | 'sales_month' | 'integrations'
  currentValue Int
  limitValue   Int
  action       String   // Ação que foi bloqueada
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([limitType])
  @@index([createdAt])
}
